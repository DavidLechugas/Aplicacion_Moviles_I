<?xml version="1.0" encoding="UTF-8"?><mxfile host="draw.io" version="24.7.17"><diagram name="01 Mapa de modelos" id="page0"><mxGraphModel dx="1400" dy="1040" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="1040"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Buñuelos Yanelys · Mapa de modelos&lt;/b&gt;&lt;br&gt;01 / Relaciones presentes en el código · Spring + MongoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBC893;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=24;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Cuenta&lt;/b&gt;&lt;br&gt;Colección: cuentas&lt;br&gt;&lt;br&gt;Representa al administrador o domiciliario que usa la aplicación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="320" height="160" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Venta&lt;/b&gt;&lt;br&gt;Colección: ventas&lt;br&gt;&lt;br&gt;Agrupa la operación de venta, sus productos, importes y pago." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="520" y="170" width="320" height="160" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;DetalleVenta&lt;/b&gt;&lt;br&gt;Objeto incluido en Venta&lt;br&gt;&lt;br&gt;Representa una línea de la venta: producto, cantidad y precio registrado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5EFDF;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1040" y="170" width="320" height="170" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Producto&lt;/b&gt;&lt;br&gt;Colección: productos&lt;br&gt;&lt;br&gt;Describe un producto disponible en el catálogo y su precio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1040" y="460" width="320" height="160" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Domicilio&lt;/b&gt;&lt;br&gt;Colección: domicilios&lt;br&gt;&lt;br&gt;Reúne los datos de entrega de una venta y su domiciliario." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="520" y="650" width="320" height="170" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Destinatario&lt;/b&gt;&lt;br&gt;Objeto incluido en Domicilio&lt;br&gt;&lt;br&gt;Contiene los datos de la persona que recibe el pedido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5EFDF;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1040" y="650" width="320" height="170" as="geometry"/></mxCell><mxCell id="e8" value="administradorId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=15;labelBackgroundColor=#FFFFFF;endArrow=block;dashed=1;strokeColor=#73553C;" edge="1" parent="1" source="n3" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="detalles: lista" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=15;labelBackgroundColor=#FFFFFF;endArrow=block;dashed=0;strokeColor=#73553C;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="productoId → codigo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=15;labelBackgroundColor=#FFFFFF;endArrow=block;dashed=1;strokeColor=#73553C;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="ventaId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=15;labelBackgroundColor=#FFFFFF;endArrow=block;dashed=1;strokeColor=#73553C;" edge="1" parent="1" source="n6" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="domiciliarioId → id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=15;labelBackgroundColor=#FFFFFF;endArrow=block;dashed=1;strokeColor=#73553C;" edge="1" parent="1" source="n6" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="destinatario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=15;labelBackgroundColor=#FFFFFF;endArrow=block;dashed=0;strokeColor=#73553C;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Cómo leer las relaciones&lt;/b&gt;&lt;br&gt;Línea continua: contiene un objeto o lista.&lt;br&gt;Línea discontinua: guarda un identificador de otro documento.&lt;br&gt;&lt;br&gt;Estas referencias no verifican por sí solas que el documento exista. La asignación de roles y las cantidades mínimas se validarán después." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1320" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="02 Cuenta y Producto" id="page1"><mxGraphModel dx="1400" dy="1020" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="1020"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Buñuelos Yanelys · Cuenta y Producto&lt;/b&gt;&lt;br&gt;Atributos exactos del código · Todos son privados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBC893;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=24;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Cuenta&lt;/b&gt;&lt;br&gt;Representa al administrador o domiciliario que usa la aplicación.&lt;br&gt;&lt;br&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br&gt;id : String&lt;br&gt;name : String&lt;br&gt;passwordHash : String&lt;br&gt;role : Rol&lt;br&gt;phone : String&lt;br&gt;state : boolean&lt;br&gt;&lt;br&gt;&lt;b&gt;Apuntes&lt;/b&gt;&lt;br&gt;id identifica la cuenta. role distingue los permisos previstos. state representa si está activa. passwordHash se omite del JSON mediante @JsonIgnore; esa anotación no cifra contraseñas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="640" height="700" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Producto&lt;/b&gt;&lt;br&gt;Describe un producto disponible en el catálogo y su precio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br&gt;codigo : String&lt;br&gt;product_name : String&lt;br&gt;description : String&lt;br&gt;category : String&lt;br&gt;image_Url : String&lt;br&gt;state : boolean&lt;br&gt;precio : BigDecimal&lt;br&gt;creadoEn : Instant&lt;br&gt;&lt;br&gt;&lt;b&gt;Apuntes&lt;/b&gt;&lt;br&gt;codigo es el @Id: no hay otro id redundante. La secuencia A001, A002… aún necesita implementación. precio se guarda como decimal; creadoEn debe asignarse." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="640" height="700" as="geometry"/></mxCell><mxCell id="n4" value="Cada clase tiene un constructor vacío, otro con sus atributos y métodos de lectura y escritura. Cuenta, Venta y Domicilio no tienen setter de id. Los nombres de los atributos se conservan tal como están en Java." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1320" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="03 Venta y DetalleVenta" id="page2"><mxGraphModel dx="1400" dy="1020" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="1020"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Buñuelos Yanelys · Venta y DetalleVenta&lt;/b&gt;&lt;br&gt;Atributos exactos del código · Todos son privados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBC893;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=24;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Venta&lt;/b&gt;&lt;br&gt;Agrupa la operación de venta, sus productos, importes y pago.&lt;br&gt;&lt;br&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br&gt;id : String&lt;br&gt;claveOperacion : String&lt;br&gt;administradorId : String&lt;br&gt;canal : CanalVenta&lt;br&gt;estado : EstadoVenta&lt;br&gt;metodoPago : MetodoPago&lt;br&gt;detalles : List&amp;lt;DetalleVenta&amp;gt;&lt;br&gt;subtotal : BigDecimal&lt;br&gt;costoDomicilio : BigDecimal&lt;br&gt;total : BigDecimal&lt;br&gt;creadoEn : Instant&lt;br&gt;pagadoEn : Instant&lt;br&gt;&lt;br&gt;&lt;b&gt;Apuntes&lt;/b&gt;&lt;br&gt;administradorId apunta a Cuenta. claveOperacion puede usarse para identificar una solicitud; hoy no evita duplicados. Importes y fechas se asignan: el modelo no los calcula." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="640" height="700" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;DetalleVenta&lt;/b&gt;&lt;br&gt;Representa una línea de la venta: producto, cantidad y precio registrado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br&gt;productoId : String&lt;br&gt;nombreProducto : String&lt;br&gt;cantidad : int&lt;br&gt;precioUnitario : BigDecimal&lt;br&gt;subtotal : BigDecimal&lt;br&gt;&lt;br&gt;&lt;b&gt;Apuntes&lt;/b&gt;&lt;br&gt;productoId referencia Producto.codigo. nombreProducto y precioUnitario permiten conservar los valores de la venta, aunque cambie el catálogo. subtotal requiere cálculo posterior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="640" height="700" as="geometry"/></mxCell><mxCell id="n4" value="Cada clase tiene un constructor vacío, otro con sus atributos y métodos de lectura y escritura. Cuenta, Venta y Domicilio no tienen setter de id. Los nombres de los atributos se conservan tal como están en Java." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1320" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="04 Domicilio y Destinatario" id="page3"><mxGraphModel dx="1400" dy="1020" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="1020"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Buñuelos Yanelys · Domicilio y Destinatario&lt;/b&gt;&lt;br&gt;Atributos exactos del código · Todos son privados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBC893;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=24;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Domicilio&lt;/b&gt;&lt;br&gt;Reúne los datos de entrega de una venta y su domiciliario.&lt;br&gt;&lt;br&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br&gt;id : String&lt;br&gt;ventaId : String&lt;br&gt;domiciliarioId : String&lt;br&gt;destinatario : Destinatario&lt;br&gt;estado : EstadoDomicilio&lt;br&gt;creadoEn : Instant&lt;br&gt;asignadoEn : Instant&lt;br&gt;entregadoEn : Instant&lt;br&gt;&lt;br&gt;&lt;b&gt;Apuntes&lt;/b&gt;&lt;br&gt;ventaId referencia Venta; domiciliarioId referencia Cuenta. destinatario está incluido en el documento. Las fechas registran creación, asignación y entrega cuando se les asigna un valor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="640" height="700" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Destinatario&lt;/b&gt;&lt;br&gt;Contiene los datos de la persona que recibe el pedido.&lt;br&gt;&lt;br&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br&gt;nombre : String&lt;br&gt;telefono : String&lt;br&gt;direccion : String&lt;br&gt;indicaciones : String&lt;br&gt;&lt;br&gt;&lt;b&gt;Apuntes&lt;/b&gt;&lt;br&gt;nombre y telefono identifican al receptor; direccion indica dónde entregar e indicaciones agrega referencias. No tiene colección ni identificador propio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="640" height="700" as="geometry"/></mxCell><mxCell id="n4" value="Cada clase tiene un constructor vacío, otro con sus atributos y métodos de lectura y escritura. Cuenta, Venta y Domicilio no tienen setter de id. Los nombres de los atributos se conservan tal como están en Java." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1320" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="05 Enumeraciones" id="page4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Buñuelos Yanelys · Enumeraciones&lt;/b&gt;&lt;br&gt;05 / Opciones fijas que clasifican los datos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBC893;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=24;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Rol&lt;/b&gt;&lt;br&gt;&lt;br&gt;ADMIN, DELIVERY&lt;br&gt;&lt;br&gt;Cuenta.role: tipo de usuario. ADMIN es administrador y DELIVERY es domiciliario." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="640" height="210" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;CanalVenta&lt;/b&gt;&lt;br&gt;&lt;br&gt;LOCAL, DOMICILIO&lt;br&gt;&lt;br&gt;Venta.canal: venta local o con domicilio. Elegir DOMICILIO no crea una entrega automáticamente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="640" height="210" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;EstadoVenta&lt;/b&gt;&lt;br&gt;&lt;br&gt;PENDIENTE, PAGADA, ANULADA&lt;br&gt;&lt;br&gt;Venta.estado: situación de la venta. El enum no ejecuta cobros ni anulaciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="640" height="210" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;MetodoPago&lt;/b&gt;&lt;br&gt;&lt;br&gt;EFECTIVO, TRANSFERENCIA&lt;br&gt;&lt;br&gt;Venta.metodoPago: forma de pago registrada. No procesa transferencias." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="720" y="390" width="640" height="210" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;EstadoDomicilio&lt;/b&gt;&lt;br&gt;&lt;br&gt;PENDIENTE, ASIGNADO, EN_CAMINO, ENTREGADO, CANCELADO&lt;br&gt;&lt;br&gt;Domicilio.estado: situación de la entrega. No asigna un conductor ni controla por sí solo los cambios de estado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="640" height="210" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Un enum limita las opciones del tipo.&lt;/b&gt;&lt;br&gt;Los campos aún pueden estar sin asignar. Requerir un valor y permitir o impedir transiciones son reglas pendientes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5EFDF;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="720" y="630" width="640" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="06 Guía de lectura" id="page5"><mxGraphModel dx="1400" dy="880" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="880"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Buñuelos Yanelys · Guía para estudiar&lt;/b&gt;&lt;br&gt;06 / Qué está definido y qué corresponde a la siguiente etapa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBC893;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=24;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Java: el molde&lt;/b&gt;&lt;br&gt;&lt;br&gt;class: define atributos y métodos de un objeto.&lt;br&gt;private: se accede a los datos a través de métodos.&lt;br&gt;Constructor: permite crear el objeto.&lt;br&gt;Getter: permite consultar un atributo.&lt;br&gt;Setter: permite asignarlo; no valida automáticamente.&lt;br&gt;List: reúne varios elementos.&lt;br&gt;BigDecimal: representa importes decimales.&lt;br&gt;Instant: representa un instante de tiempo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="640" height="360" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;MongoDB: cómo se guardará&lt;/b&gt;&lt;br&gt;&lt;br&gt;@Document: indica una colección.&lt;br&gt;@Id: identifica el documento en MongoDB.&lt;br&gt;@Field DECIMAL128: guarda el importe con tipo decimal.&lt;br&gt;@JsonIgnore: excluye passwordHash del JSON.&lt;br&gt;&lt;br&gt;DetalleVenta y Destinatario tienen archivos propios, pero se guardan dentro de Venta y Domicilio. Separar archivos no crea colecciones adicionales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="640" height="360" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Ya representado por los modelos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Usuarios y rol; catálogo y precios; venta y sus líneas; canal, pago y estado; entrega y receptor.&lt;br&gt;&lt;br&gt;Son estructuras de datos. La clase de práctica UserModel no forma parte de estos apuntes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5EFDF;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="640" height="270" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Pendiente de implementar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validaciones, códigos consecutivos de producto, fechas automáticas, cálculo de importes, protección de contraseñas, reglas de estados, comprobación de referencias y prevención de duplicados.&lt;br&gt;&lt;br&gt;Este documento no presenta esas reglas como funciones ya terminadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EC;strokeColor=#CDA66F;fontColor=#382B24;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="720" y="550" width="640" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>